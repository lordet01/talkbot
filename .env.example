# XIAO ESP32S3 serial port (Mac: /dev/cu.usbmodemXXXX)
SERIAL_PORT=/dev/cu.usbmodem1101

# Serial baud rate (must match Arduino sketch)
BAUD_RATE=115200

# Audio capture settings (02_i2s_csv_stream)
SAMPLE_RATE=16000
CHANNELS=1

# Wi-Fi (ESP32 05_groq_voice_chat — scripts/sync_secrets.sh)
WIFI_SSID=
WIFI_PASSWORD=

# Groq API key (https://console.groq.com/keys)
GROQ_API=

# Optional: Google Cloud Text-to-Speech API key (Orpheus 약관 미수락 시 fallback)
# https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
GOOGLE_API=

# Voice chatbot (test TTS: Groq Orpheus English only)
GROQ_LLM_MODEL=groq/compound-mini
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
CHAT_LANGUAGE=ko
