# XIAO ESP32S3 serial port (Mac: /dev/cu.usbmodemXXXX)
SERIAL_PORT=/dev/cu.usbmodem1101

# Serial baud rate (must match Arduino sketch)
BAUD_RATE=115200

# Audio capture settings (02_i2s_csv_stream)
SAMPLE_RATE=16000
CHANNELS=1

# Wi-Fi (optional seed for NVS auto-connect; leave empty to use SoftAP portal)
# Portal: join AP "Talkbot-Setup" → http://192.168.4.1
WIFI_SSID=
WIFI_PASSWORD=

# Groq API key (https://console.groq.com/keys)
GROQ_API=

# Optional: Google Cloud Text-to-Speech API key (primary TTS)
# Enable API: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
GOOGLE_API=

# Voice chatbot
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
CHAT_LANGUAGE=ko
# Google TTS (ko female WaveNet + mild pitch)
GOOGLE_TTS_VOICE=ko-KR-Wavenet-A
GOOGLE_TTS_PITCH=+4st
