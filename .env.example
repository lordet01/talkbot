# XIAO ESP32S3 serial port (Mac: /dev/cu.usbmodemXXXX)
SERIAL_PORT=/dev/cu.usbmodem1101

# Serial baud rate (must match Arduino sketch)
BAUD_RATE=115200

# Audio capture settings (02_i2s_csv_stream)
SAMPLE_RATE=16000
CHANNELS=1

# Wi-Fi (optional seed for NVS auto-connect; leave empty to use SoftAP portal)
# Portal: join AP "Talkbot-Setup" → http://192.168.4.1
WIFI_SSID=
WIFI_PASSWORD=

# Groq API key (https://console.groq.com/keys)
GROQ_API=

# Google Cloud TTS API key (Chirp3). Do not reuse for Gemini if the key is TTS-restricted.
GOOGLE_API=

# Google AI Studio Gemini key (LLM only): https://aistudio.google.com/apikey
GOOGLE_API_GEMINI=

# Voice chatbot
GEMINI_LLM_MODEL=gemini-3.1-flash-lite
GROQ_STT_MODEL=whisper-large-v3-turbo
CHAT_LANGUAGE=ko
# Google TTS (Chirp3 HD Korean — natural conversational)
GOOGLE_TTS_VOICE=ko-KR-Chirp3-HD-Kore
# Encoding/rate are hardcoded in firmware: LINEAR16 @ 16 kHz, no pitch lift

# Parent control panel on Cloudflare (doll floor QR). DO NOT change this hostname.
CONTROL_PANEL_URL=https://talkbot-control-panel.nine-raptorex.workers.dev
